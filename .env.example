# Copy to .env for local runs. In Coolify, set these under the app's Environment Variables.
# NEVER commit real values.

# Shopify — use the myshopify.com domain, not petchef.co.in
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional: only if you have a legacy shpat_ admin token instead of client ID/secret
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2026-07

# Dashboard login
DASHBOARD_PASSWORD=          # 12+ chars, shared with the team
SESSION_SECRET=              # 32+ random chars: openssl rand -hex 32

# Sync (defaults shown)
# SYNC_AT_IST=02:30          # nightly sync time (IST)
# COD_GATEWAY_REGEX=cod|cash on delivery
# DATA_DIR=/data             # must be a persistent volume in Coolify
